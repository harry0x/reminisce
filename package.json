  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0"
